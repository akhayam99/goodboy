{
  "name": "goodboy-website",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --port 1499 --host",
    "build": "tsc -b && node scripts/prerender.mjs",
    "test": "node --test scripts/*.test.mjs",
    "build:brand": "node scripts/build-brand-assets.mjs",
    "sync:tokens": "node scripts/sync-app-tokens.mjs",
    "check:page": "node scripts/sync-app-tokens.mjs --check && node scripts/sync-icons.mjs --check && node scripts/check-page.mjs",
    "preview": "vite preview --port 1499"
  },
  "dependencies": {
    "@vercel/analytics": "^2.0.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^4.3.4",
    "marked": "^18.0.14",
    "tailwindcss": "^4.3.2",
    "typescript": "^5.6.3",
    "vite": "^6.0.0"
  }
}
