{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "workspaces": {
    ".": {
      "entry": ["package.json", "eslint.strict.config.mjs"],
      "ignore": ["scripts/rules/forbiddenPatterns.d.mts"],
      "ignoreBinaries": ["cwebp", "vite", "preview"]
    },
    "apps/desktop": {
      "entry": ["src/__tests__/regressions/console-guard/*.fixture.ts"],
      "project": [
        "src/**/*.{ts,tsx}!",
        "!src/__tests__/**!",
        "!src/app/components/MockScene/**!",
        "!src/**/testing/**!",
        "!src/store/storyHarness.ts!",
        "src/**/*.css"
      ],
      "ignoreIssues": {
        "src/features/artifacts/artifactMirror/artifactMirrorQueue.ts": ["exports"],
        "src/features/chat/spawn-from-comment.ts": ["exports"],
        "src/features/chat/utils/transcript-items-trace.ts": ["exports"],
        "src/features/companion/mobileConfinement.ts": ["exports"],
        "src/features/history/historyEngine.ts": ["exports"],
        "src/features/integrations/gitlab/MergeRequest/MrDetailPanel/mrDraftTitle.ts": ["exports"],
        "src/features/integrations/hooks/useIssueLookup/index.ts": ["exports"],
        "src/features/context/slotRouting.ts": ["exports"],
        "src/features/session/agent-kind.ts": ["exports"],
        "src/store/runtime/worktreeStatuses/cache.ts": ["exports"],
        "src/features/workTreeModel/workTime.ts": ["exports"],
        "src/store/slices/artifacts/artifactScoutRun.ts": ["exports"],
        "src/store/slices/branch-cleanup/repoDeletesMergedBranches.ts": ["exports"],
        "src/store/slices/open-questions/resolveQuestionDelegate.ts": ["exports"],
        "src/store/slices/project-mounts/mountRecoveryGuard.ts": ["exports"],
        "src/store/slices/turn/mountContinuations.ts": ["exports"],
        "src/store/slices/turn/turnStartWindow.ts": ["exports"],
        "src/store/slices/turn/workflowTurnBreaker.ts": ["exports"],
        "src/app/hooks/useAppOverlays/overlayState.ts": ["types"],
        "src/features/history/historyBackupRef.ts": ["exports"],
        "src/store/slices/budget/index.ts": ["types"],
        "src/store/slices/session-view/index.ts": ["exports"],
        "src/store/slices/session-view/types.ts": ["exports"],
        "src/features/session/timeline/activityView.ts": ["exports"]
      }
    },
    "packages/core": {
      "entry": ["src/**/*.test.ts", "src/**/__tests__/**/*.test.ts"],
      "project": ["src/**/*.ts"]
    },
    "packages/db": {
      "entry": ["src/**/*.test.ts"],
      "project": ["src/**/*.ts"]
    },
    "packages/types": {
      "project": ["src/**/*.ts"]
    },
    "packages/ui": {
      "entry": ["src/**/*.test.{ts,tsx}"],
      "project": ["src/**/*.{ts,tsx}"],
      "ignoreIssues": {
        "src/motionTimings.ts": ["duplicates"]
      }
    },
    "website": {
      "entry": ["src/prerender/renderSite.tsx"],
      "project": ["src/**/*.{ts,tsx}", "src/**/*.css"],
      "ignoreDependencies": ["tailwindcss"]
    }
  },
  "ignoreExportsUsedInFile": true
}
