{
  "name": "@goodboy/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./mount-pr-link": {
      "types": "./src/queries/mount-pr-link.ts",
      "default": "./src/queries/mount-pr-link.ts"
    },
    "./session-error-repair": {
      "types": "./src/queries/session-error-repair.ts",
      "default": "./src/queries/session-error-repair.ts"
    },
    "./turn-role-insight": {
      "types": "./src/queries/turn-role-insight.ts",
      "default": "./src/queries/turn-role-insight.ts"
    },
    "./migrations": {
      "types": "./src/migrations/boot.ts",
      "default": "./src/migrations/boot.ts"
    },
    "./test-helpers": {
      "types": "./src/test-helpers/test-db.ts",
      "default": "./src/test-helpers/test-db.ts"
    },
    "./test-helpers/auto-seeds": {
      "types": "./src/test-helpers/auto-seeds.ts",
      "default": "./src/test-helpers/auto-seeds.ts"
    },
    "./test-helpers/auto-work-seeds": {
      "types": "./src/test-helpers/auto-work-seeds.ts",
      "default": "./src/test-helpers/auto-work-seeds.ts"
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run --project unit --passWithNoTests",
    "test:perf": "vitest run --project perf --passWithNoTests"
  },
  "dependencies": {
    "@goodboy/types": "workspace:*"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "better-sqlite3": "^13.2.0",
    "typescript": "^5.6.3",
    "vitest": "4.1.10"
  }
}
