{
  "name": "goodboy",
  "version": "0.1.23",
  "private": true,
  "description": "AI workspace orchestrator. Local-first, provider-agnostic.",
  "license": "MIT",
  "author": "Amin Khayam <amin@khayam.dev>",
  "repository": {
    "type": "git",
    "url": "https://github.com/akhayam99/goodboy.git"
  },
  "engines": {
    "node": ">=20",
    "pnpm": ">=9"
  },
  "packageManager": "pnpm@10.33.4",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "tauri:dev": "pnpm --filter @goodboy/desktop tauri:dev",
    "tauri:build": "pnpm --filter @goodboy/desktop tauri:build",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "knip": "knip",
    "prepare": "lefthook install"
  },
  "devDependencies": {
    "@commitlint/cli": "^20.5.3",
    "@commitlint/config-conventional": "^20.5.3",
    "knip": "^6.17.2",
    "lefthook": "^2.1.9",
    "prettier": "^3.8.4",
    "turbo": "^2.9.18",
    "typescript": "^5.6.3"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3",
      "esbuild",
      "lefthook"
    ]
  }
}
