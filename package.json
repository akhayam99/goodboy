{
  "name": "goodboy",
  "version": "0.23.1",
  "private": true,
  "description": "AI workspace orchestrator. Local-first, provider-agnostic.",
  "license": "FSL-1.1-MIT",
  "author": "Amin Khayam <amin@khayam.dev>",
  "repository": {
    "type": "git",
    "url": "https://github.com/akhayam99/goodboy.git"
  },
  "engines": {
    "node": ">=22",
    "pnpm": ">=10"
  },
  "packageManager": "pnpm@10.33.4",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint && pnpm run check:tauri-commands && pnpm run check:doc-refs",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test --continue",
    "test:perf": "turbo run test:perf --continue",
    "tauri:dev": "pnpm --filter @goodboy/desktop tauri:dev",
    "tauri:build": "pnpm --filter @goodboy/desktop tauri:build",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "knip": "knip",
    "knip:production": "knip --workspace apps/desktop --production --include files,exports,types",
    "check:tauri-commands": "node scripts/check-tauri-commands.mjs",
    "check:doc-refs": "node scripts/check-doc-refs.mjs && node scripts/check-feature-docs.mjs && node scripts/check-feature-anchors.mjs && node scripts/check-figure-versions.mjs",
    "release:kind": "node scripts/release-kind.mjs",
    "changelog:shots": "node scripts/changelog-shots.mjs",
    "features:shots": "node scripts/feature-shots.mjs",
    "fidelity:shots": "node scripts/fidelity-shots.mjs",
    "validate:scenes": "node scripts/validate-scenes.mjs",
    "readme:hero": "node scripts/readme-hero.mjs",
    "features:check": "node scripts/split-features.mjs --check",
    "features:snapshot": "node scripts/snapshot-features.mjs",
    "test:scripts": "node --test scripts/snapshot-features.test.mjs scripts/check-feature-anchors.test.mjs scripts/check-figure-versions.test.mjs scripts/ci-changes.test.mjs scripts/ci-gate.test.mjs scripts/check-test-shards.test.mjs",
    "codemod:type-roles": "node scripts/codemods/type-roles.mjs",
    "prepare": "lefthook install"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "knip": "^6.38.0",
    "lefthook": "^2.1.14",
    "prettier": "^3.9.9",
    "turbo": "^2.11.5",
    "typescript": "^5.6.3"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3",
      "esbuild",
      "lefthook"
    ]
  }
}
