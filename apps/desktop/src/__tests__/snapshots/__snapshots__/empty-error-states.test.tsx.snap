                    />
                    <path
                      d="M21 16h-4"
                    />
                    <path
                      d="M11 3H9"
                    />
                  </svg>
                </button>
              </div>
            </div>
          </div>
        </section>
      </div>
    </div>
    <div
      aria-orientation="horizontal"
      class="h-px w-full bg-gradient-to-r from-transparent via-border-soft to-transparent"
      role="separator"
    />
    <footer
      class="flex shrink-0 items-center justify-end gap-2 px-6 py-3"
