                  placeholder="branch-slug"
                  spellcheck="false"
                  type="text"
                  value=""
                />
                <button
                  aria-label="Generate branch name"
                  class="shrink-0 rounded-md border border-border px-2 py-1.5 text-xs transition-colors cursor-not-allowed text-muted-foreground/30"
                  disabled=""
