{
  "mutations": [
    "resolveReviewThread",
    "addPullRequestReviewThreadReply",
    "updatePullRequestReviewComment",
    "addPullRequestReview",
    "addPullRequestReviewThread",
    "submitPullRequestReview",
    "deletePullRequestReview"
  ],
  "shapes": [
    {
      "id": "pr-view",
      "verb": ["pr", "view"],
      "positional": ["{ref}?"],
      "flags": [
        { "name": "--repo", "slot": "slug" },
        { "name": "--json", "slot": "fields" },
        { "name": "--jq", "slot": "text" }
      ]
    },
    {
      "id": "pr-list",
      "verb": ["pr", "list"],
      "positional": [],
      "flags": [
        { "name": "--repo", "slot": "slug" },
        { "name": "--head", "slot": "text" },
        { "name": "--state", "values": ["open", "closed", "merged", "all"] },
        { "name": "--limit", "slot": "number" },
        { "name": "--json", "slot": "fields" },
        { "name": "--search", "slot": "text" }
      ]
    },
    {
      "id": "pr-create",
      "verb": ["pr", "create"],
      "positional": [],
      "flags": [
        { "name": "--repo", "slot": "slug" },
        { "name": "--head", "slot": "text" },
        { "name": "--base", "slot": "text" },
        { "name": "--title", "slot": "text" },
        { "name": "--body", "slot": "text" },
        { "name": "--fill", "slot": null },
        { "name": "--draft", "slot": null }
      ]
    },
    {
      "id": "pr-edit",
      "verb": ["pr", "edit"],
      "positional": ["{ref}"],
      "flags": [
        { "name": "--title", "slot": "text" },
        { "name": "--body", "slot": "text" },
        { "name": "--add-reviewer", "slot": "text" }
      ]
    },
    {
      "id": "pr-ready",
      "verb": ["pr", "ready"],
      "positional": ["{ref}?"],
      "flags": [{ "name": "--undo", "slot": null }]
    },
    {
      "id": "pr-merge",
      "verb": ["pr", "merge"],
      "positional": ["{ref}?"],
      "flags": [
        { "name": "--squash", "slot": null },
        { "name": "--merge", "slot": null },
        { "name": "--rebase", "slot": null },
        { "name": "--disable-auto", "slot": null },
        { "name": "--match-head-commit", "slot": "sha" }
      ]
    },
    {
      "id": "pr-close",
      "verb": ["pr", "close"],
      "positional": ["{ref}"],
      "flags": []
    },
    {
      "id": "pr-reopen",
      "verb": ["pr", "reopen"],
      "positional": ["{ref}"],
      "flags": []
    },
    {
      "id": "pr-diff",
      "verb": ["pr", "diff"],
      "positional": ["{ref}?"],
      "flags": [{ "name": "--repo", "slot": "slug" }]
    },
    {
      "id": "pr-checks",
      "verb": ["pr", "checks"],
      "positional": ["{ref}?"],
      "flags": [
        { "name": "--repo", "slot": "slug" },
        { "name": "--json", "slot": "fields" }
      ]
    },
    {
      "id": "pr-comment",
      "verb": ["pr", "comment"],
      "positional": ["{ref}?"],
      "flags": [{ "name": "--body", "slot": "text" }]
    },
    {
      "id": "issue-view",
