#!/bin/sh
. "$(dirname "$0")/common.sh"
case "$1" in
  --version)
    fake_version "2.1.4 (Claude Code)"
    ;;
  auth)
    case "$fake_mode" in
      logged-out)
        printf '{"loggedIn":false,"authMethod":"none","apiProvider":"firstParty"}\n'
        exit 1
        ;;
      slow)
        fake_hang
        ;;
      garbage)
        printf 'something new and unexpected\n'
        exit 1
        ;;
      *)
        printf '{"loggedIn":true,"email":"avery@harborline.test","subscriptionType":"max"}\n'
        ;;
    esac
    ;;
  *)
    fake_turn claude.jsonl "$@"
    ;;
esac
